{
  "name": "qa-skills-live-evidence",
  "version": "0.1.0",
  "private": true,
  "description": "Live-evidence test project for the qa-skills plugin.",
  "scripts": {
    "fallback:start": "bash scripts/fallback-start.sh",
    "fallback:reset": "bash scripts/fallback-reset.sh",
    "fallback:stop": "bash scripts/fallback-stop.sh",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "typecheck": "tsc",
    "fixture:start": "node fixture/header-api/server.mjs",
    "scan:header": "node scripts/header-fixture/scan-secret.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "typescript": "^5.9.3"
  }
}
