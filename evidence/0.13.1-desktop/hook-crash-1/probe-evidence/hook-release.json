{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/tester-guard.mjs\"",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/tester-bind.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
